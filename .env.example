# Token do bot (fale com o @BotFather)
TELEGRAM_TOKEN=

# ID do grupo/canal que recebe as promoções (ex.: -1001234567890).
# Dica: adicione o bot ao grupo e mande /chatid para descobrir.
GROUP_ID=

# URL do backend que devolve a lista de promoções (opcional).
# Sem ela, o polling fica desligado e só a API HTTP publica promoções.
BACKEND_URL=http://localhost:4000/mock-promos

# Intervalo do polling em minutos (padrão: 5)
POLL_INTERVAL_MINUTES=5

# Porta da API HTTP (padrão: 3000)
PORT=3000

# Se definida, o POST /promo exige o header "x-api-key" com este valor.
API_KEY=
