# Token do bot (fale com o @BotFather)
TELEGRAM_TOKEN=

# ID do grupo/canal que recebe as promoções (ex.: -1001234567890).
# Dica: adicione o bot ao grupo e mande /chatid para descobrir.
GROUP_ID=

# URL do backend que devolve a lista de promoções (opcional).
# Sem ela, o polling fica desligado; agente e API HTTP continuam independentes.
BACKEND_URL=http://localhost:4000/mock-promos

# Intervalo do polling em minutos (padrão: 5)
POLL_INTERVAL_MINUTES=5

# Porta da API HTTP (padrão: 3000)
PORT=3000

# Se definida, /promo e /jobs exigem o header "x-api-key" com este valor.
API_KEY=

# Configuração do agente; arquivo ausente desliga o agente.
AGENT_CONFIG=./agent.config.json

# Histórico compartilhado em DATA_DIR/sent.json.
DATA_DIR=./data

# IDs de usuários Telegram separados por vírgula; vazio desabilita admin.
ADMIN_IDS=

# Preencha a chave correspondente a llm.provider.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Shopee Affiliate Open API (necessárias para jobs com shopee).
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Mercado Livre experimental (necessárias para jobs com mercadolivre).
ML_CLIENT_ID=
ML_CLIENT_SECRET=
